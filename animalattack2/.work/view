function audioFX(kind){if(!save.settings.sound||MILESTONE<4)return;if(kind==='win'){[523,659,784,1047].forEach((f,i)=>tone(f,.3,'sine',.055,i*.13));}else if(kind==='chomp'){tone(160+Math.random()*80,.055,'triangle',.024);}else if(kind==='deploy'){tone(450,.13,'sine',.06);tone(710,.09,'sine',.035,.08);}else tone(330,.11,'triangle',.04);}
function musicUpdate(dt){if(!audio||!save.settings.music||MILESTONE<4)return;musicTimer-=dt;if(musicTimer<=0){musicTimer=.48;const notes=[262,330,392,330,294,349,440,349,262,330,523,392,294,349,392,294];tone(notes[musicStep++%notes.length],.42,'sine',.014);}}
function vibrate(pattern=12){if(save.settings.haptics&&navigator.vibrate&&!reduced)navigator.vibrate(pattern);}
// ═══════════════════ INPUT + UI/HUD ═══════════════════
let state=null,levelIndex=0,history=[],busy=false,speed=false,hintColumn=-1,awarded=false,booted=false;
function antIcon(){return '<svg class="anticon" viewBox="0 0 40 44"><use href="#i-ant"/></svg>';}
function applyLanguage(){document.documentElement.lang=save.settings.language;for(const el of document.querySelectorAll('[data-t]'))el.innerHTML=t(el.dataset.t);$('#map').setAttribute('aria-label',t('map'));$('#settings').setAttribute('aria-label',t('settings'));$('#retry').setAttribute('aria-label',t('retry'));if(state)updateUI();}
function updateUI(){if(!state)return;const shown=animation?.displayState||state;const level=levels[levelIndex],used=shown.active.filter(Boolean).length,total=level.layers.flat().join('').replaceAll('.','').length,left=visualCells.filter(c=>c!=='.').length,percent=Math.round((total-left)/total*100);$('#level-label').textContent=`${t('worlds')[level.tier]} · ${t('level')} ${String(levelIndex+1).padStart(2,'0')}`;$('#level-title').textContent=level.name[save.settings.language==='de'?1:0];$('#progress').style.width=`${percent}%`;$('.progress').setAttribute('aria-valuenow',percent);$('#progress-text').textContent=`${percent}% ${t('munched')}`;$('#coins').textContent=save.coins;$('#slot-count').textContent=`${used} / ${state.active.length} ${t('spots')}`;$('#layer-tag').textContent=state.depth===1?t('fresh'):`${state.depth} ${t('layers')} · ${t('animalNames')[state.columns.flat()[0]?.type||'ant'].toUpperCase()}`;$('#slots').style.gridTemplateColumns=`repeat(${state.active.length},minmax(0,1fr))`;
$('#slots').innerHTML=shown.active.map((q,i)=>q?`<div class="slot filled" style="--squad:${PALETTE[q.color]}" title="${t('colors')[q.color]} · ${q.bites}">${antIcon()}<b>${q.bites}</b><small>${busy?'':t('rest')}</small></div>`:`<div class="slot" aria-label="${t('spots')} ${i+1}">+</div>`).join('');
$('#queues').innerHTML=shown.columns.map((column,c)=>`<div class="column">${column.length?column.slice(0,3).map((q,j)=>`<button class="nest ${j?'queued':''} ${hintColumn===c&&j===0?'safe':''}" style="--squad:${PALETTE[q.color]};color:${['C','Y','W'].includes(q.color)?'var(--ink)':'var(--white)'}" data-column="${c}" ${j||busy||state.status!=='playing'?'disabled':''} aria-label="${t('colors')[q.color]}, ${q.bites} ${t('animalNames')[q.type]}, ${c+1}"><span class="symbol">${SYMBOLS[q.color]}</span>${antIcon()}<b>${q.bites}</b></button>`).join(''):'<div class="empty-nest">·</div>'}</div>`).join('');
for(let i=0;i<nestBadges.length;i++){const g=nestBadges[i],q=shown.columns[i]?.[0],key=q?String(q.bites):'·';if(g.userData.lastBadge!==key){g.userData.lastBadge=key;const tx=g.userData.badge,c=tx.image.getContext('2d');c.clearRect(0,0,128,128);c.fillStyle='#fff5d9';c.beginPath();c.roundRect(8,12,112,94,24);c.fill();c.fillStyle='#46583a';c.font='bold 52px sans-serif';c.textAlign='center';c.fillText(key,64,79);tx.needsUpdate=true;}}
$('#undo').disabled=busy||!history.length;$('#extra').disabled=busy||state.extra||state.status==='win'||state.columns.every(c=>!c.length);$('#hint').disabled=busy||state.status!=='playing';$('#retry').disabled=busy;$('#speed').textContent=`» ${speed?'2':'1'}×`;$('#speed').setAttribute('aria-pressed',speed);$('#tutorial').textContent=busy?t('working'):state.active.some(Boolean)?t('waiting'):levelIndex<5?t('tutorials')[levelIndex]:t('tap');}
function loadLevel(index){if(!levels[index])return;levelIndex=index;state=createState(levels[index]);history=[];animation=null;busy=false;awarded=false;hintColumn=-1;celebrateUntil=0;syncBoard(state);save.level=index;persist();updateUI();$('#modal').close();}
function deploy(column){if(!booted||busy||$('#modal').open)return;unlockAudio();const result=playRound(state,column);if(!result.valid)return;const before=cloneState(state);history.push(before);state=result.state;hintColumn=-1;busy=true;animation=prepareAnimation(result.events);animation.displayState=cloneState(before);animation.displayState.active[result.events[0].slot]={...result.events[0].squad};audioFX('deploy');vibrate();updateUI();if(reduced){for(const job of animation.jobs)job.start=0;animation.duration=.15;}}
function finishRound(){const count=animation?.count||0;animation=null;busy=false;syncBoard(state);updateUI();if(count>=15&&MILESTONE>=4){cameraNudge=reduced?0:Math.min(.1,count*.001);$('#combo').textContent=`${t('chomp')} +${count}`;$('#combo').classList.add('show');setTimeout(()=>$('#combo').classList.remove('show'),1300);}if(state.status==='win'){celebrateUntil=clockTime+5;audioFX('win');vibrate([20,40,20]);if(MILESTONE>=4&&!awarded){const stars=state.round<=levels[levelIndex].par?3:state.round<=levels[levelIndex].par+2?2:1;const old=Number(save.stars[levelIndex])||0;save.coins+=old?5:30+stars*10;save.stars[levelIndex]=Math.max(old,stars);save.unlocked=Math.max(save.unlocked,Math.min(levels.length,levelIndex+2));persist();awarded=true;}for(let i=0;i<32;i++)burst((i*31)%256,Object.values(PALETTE)[i%10],true);updateUI();setTimeout(()=>{if(state.status==='win')showResult(true);},650);}else if(state.status==='lose')showResult(false);}
function undo(){if(busy||!history.length)return;state=history.pop();animation=null;hintColumn=-1;syncBoard(state);$('#modal').close();updateUI();audioFX('pop');}
function extra(){if(busy||state.extra||state.status==='win')return;history.push(cloneState(state));state=addSpot(state);$('#modal').close();updateUI();$('#tutorial').textContent=t('slotAdded');audioFX('pop');}
function hint(){if(busy||state.status!=='playing')return;const result=solve(state,30000);if(result.route?.length){hintColumn=result.route[0];updateUI();$('#tutorial').textContent=t('safe');}else $('#tutorial').textContent=t(result.limited?'unknown':'noHint');}
function modalFrame(title,body){return `<div class="dialog-head"><h2>${title}</h2><button class="close" data-action="close" aria-label="${t('close')}">×</button></div>${body}`;}
let focusBeforeModal=null;
function showModal(html){focusBeforeModal=document.activeElement;$('#modal').innerHTML=html;if(!$('#modal').open)$('#modal').showModal();}
function showSettings(){showModal(modalFrame(t('settings'),['sound','music','haptics','language'].map(k=>`<div class="setting"><span>${t(k)}</span><button data-setting="${k}" ${k==='language'?'':`aria-pressed="${save.settings[k]}"`}>${k==='language'?(save.settings.language==='en'?'English':'Deutsch'):t(save.settings[k]?'on':'off')}</button></div>`).join('')+`<p class="modal-copy">${t('help')}</p><p class="modal-copy">${t('keys')}</p>`));}
function showMap(){let body='';for(let tier=0;tier<Math.ceil(levels.length/6);tier++){body+=`<p class="eyebrow">${t('worlds')[tier]} · ${t('tiers')[tier]}</p><div class="map-grid">`;for(let n=tier*6;n<Math.min(levels.length,tier*6+6);n++)body+=`<button class="map-level ${n===levelIndex?'current':''}" data-level="${n}" ${n>=save.unlocked?'disabled':''} aria-label="${t('level')} ${n+1}${n>=save.unlocked?', '+t('locked'):''}">${n>=save.unlocked?'·':n+1}<span>${'★'.repeat(save.stars[n]||0)||'○'}</span></button>`;body+='</div>';}showModal(modalFrame(t('map'),body));}
function showResult(win){const stars=save.stars[levelIndex]||3;showModal(`<div class="result"><div class="big-star">${win?'★'.repeat(stars):'↶'}</div><h2>${t(win?'win':'lose')}</h2><p class="modal-copy">${t(win?'winCopy':'loseCopy')}</p>${win?`<p class="eyebrow">${state.round} ${t('rounds')} · ${levels[levelIndex].par} PAR</p>`:''}<div class="modal-actions">${win?`<button class="primary" data-action="next">${t(levelIndex===levels.length-1?'map':'next')} →</button><button class="secondary" data-action="retry">${t('retry')}</button>`:`<button class="primary" data-action="undo" ${history.length?'':'disabled'}>${t('undo')}</button><button class="secondary" data-action="retry">${t('retry')}</button>${state.extra?'':`<button class="secondary" data-action="extra">${t('extra')}</button>`}`}</div></div>`);}
$('#queues').addEventListener('click',e=>{const b=e.target.closest('[data-column]');if(b&&!b.disabled)deploy(Number(b.dataset.column));});
$('#undo').onclick=undo;$('#extra').onclick=extra;$('#hint').onclick=hint;$('#retry').onclick=()=>loadLevel(levelIndex);$('#speed').onclick=()=>{speed=!speed;updateUI();};$('#map').onclick=showMap;$('#settings').onclick=showSettings;
$('#modal').addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;unlockAudio();if(b.dataset.setting){const k=b.dataset.setting;if(k==='language')save.settings.language=save.settings.language==='en'?'de':'en';else save.settings[k]=!save.settings[k];persist();applyLanguage();showSettings();return;}if(b.dataset.level!==undefined){loadLevel(Number(b.dataset.level));return;}switch(b.dataset.action){case'close':$('#modal').close();break;case'next':levelIndex===levels.length-1?showMap():loadLevel(levelIndex+1);break;case'retry':loadLevel(levelIndex);break;case'undo':undo();break;case'extra':extra();break;}});
$('#modal').addEventListener('close',()=>focusBeforeModal?.focus?.());
document.addEventListener('keydown',e=>{if($('#modal').open||e.ctrlKey||e.altKey||e.metaKey||e.repeat)return;if(/^[1-5]$/.test(e.key)){e.preventDefault();deploy(Number(e.key)-1);}else if(e.key.toLowerCase()==='u')undo();else if(e.key.toLowerCase()==='r'&&!busy)loadLevel(levelIndex);else if(e.key.toLowerCase()==='f'){$('#speed').click();}});
document.addEventListener('pointerdown',unlockAudio,{once:true});
document.addEventListener('visibilitychange',()=>{if(document.hidden){audio?.suspend();lastTime=0;}else{lastTime=0;if(audio&&(save.settings.sound||save.settings.music))audio.resume().catch(()=>{});}});
// ═══════════════════ MAIN LOOP — fixed-step animation simulation and adaptive rendering ═══════════════════
let lastTime=0,accumulator=0,averageMs=16.7,slowFrames=0,frames=0,fpsTime=0,lastUI=0;
function loop(ms){requestAnimationFrame(loop);if(document.hidden||!booted)return;if(!lastTime){lastTime=ms;fpsTime=ms;frames=0;return;}const raw=ms-lastTime,dt=Math.min(.06,raw/1000);lastTime=ms;averageMs=averageMs*.98+raw*.02;if(averageMs>20)slowFrames++;else slowFrames=Math.max(0,slowFrames-1);if(slowFrames>180&&quality===1){quality=.7;renderer.setPixelRatio(Math.min(devicePixelRatio,1.25));resize();}accumulator+=dt;while(accumulator>=CONFIG.step){clockTime+=CONFIG.step;if(animation)animation.time+=CONFIG.step*(speed?2:1);musicUpdate(CONFIG.step);advanceCrumbs(CONFIG.step);accumulator-=CONFIG.step;}animateScene(accumulator);if(animation&&ms-lastUI>150){const total=levels[levelIndex].layers.flat().join('').replaceAll('.','').length,remaining=visualCells.filter(c=>c!=='.').length,percent=Math.round((total-remaining)/total*100);$('#progress').style.width=percent+'%';$('.progress').setAttribute('aria-valuenow',percent);$('#progress-text').textContent=`${percent}% ${t('munched')}`;updateUI();lastUI=ms;}frames++;if(params.has('debug')&&ms-fpsTime>500){$('#debug').hidden=false;$('#debug').textContent=`${Math.round(frames*1000/(ms-fpsTime))} FPS · ${renderer.info.render.calls} calls · ${CONFIG.heroes+swarm[0].count} ants\nDPR ${renderer.getPixelRatio()} · ${levels.length} verified levels`;frames=0;fpsTime=ms;}}
async function boot(){applyLanguage();$('#loading').textContent=t('loading');const count=MILESTONE<3?3:24;for(let i=0;i<count;i++){levels.push(generateLevel(i));if(i%2===0)await new Promise(r=>setTimeout(r,0));}const requested=Number(params.get('level'));loadLevel(params.has('level')?Math.max(0,Math.min(count-1,(requested||1)-1)):Math.min(save.level,count-1));$('#loading').hidden=true;booted=true;resize();requestAnimationFrame(loop);}
