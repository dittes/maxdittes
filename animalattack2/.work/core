function createState(level,columns=level.columns){let cells=[];for(let z=0;z<level.layers.length;z++)for(let y=0;y<level.h;y++)for(let x=0;x<level.w;x++)cells.push(level.layers[z][y][x]);return{w:level.w,h:level.h,depth:level.layers.length,cells,columns:columns.map(c=>c.map(n=>({...n}))),active:Array(5).fill(null),round:0,status:'playing',extra:false};}
function cloneState(s){return{...s,cells:s.cells.slice(),columns:s.columns.map(c=>c.map(n=>({...n}))),active:s.active.map(n=>n?{...n}:null)};}
function exposed(s,id){const layer=s.w*s.h;for(let above=id+layer;above<s.cells.length;above+=layer)if(s.cells[above]!=='.')return false;return s.cells[id]!=='.';}
function reachable(s,id,type){if(exposed(s,id))return true;if(type!=='grasshopper'||s.cells[id]==='.')return false;const layer=s.w*s.h;return id+layer<s.cells.length&&exposed(s,id+layer);}
function target(s,q,slot){let best=-1,dist=Infinity;const sx=(slot+.5)*s.w/s.active.length;for(let i=0;i<s.cells.length;i++){if(s.cells[i]!==q.color||!reachable(s,i,q.type))continue;let x=i%s.w,y=Math.floor(i/s.w)%s.h,z=Math.floor(i/(s.w*s.h));const d=(x-sx)**2+(s.h+2-y)**2+z*.03;if(d<dist){dist=d;best=i;}}return best;}
const BITE={ant:(s,id)=>[id],beetle:(s,id)=>[id],grasshopper:(s,id)=>[id],ladybug:(s,id)=>{const x=id%s.w,y=Math.floor(id/s.w)%s.h;const near=[x>0?id-1:-1,x<s.w-1?id+1:-1,y>0?id-s.w:-1,y<s.h-1?id+s.w:-1];const b=near.find(n=>n>=0&&s.cells[n]===s.cells[id]&&exposed(s,n));return b===undefined?[id]:[id,b];}};
