function playRound(input,column,emit=true){if(input.status!=='playing'||!input.columns[column]?.length)return{state:input,events:[],valid:false};const slot=input.active.indexOf(null);if(slot<0)return{state:input,events:[],valid:false};const state=cloneState(input),squad=state.columns[column].shift();state.active[slot]={...squad};state.round++;const events=emit?[{kind:'deploy',slot,column,squad:{...squad}}]:null;resolve(state,events);return{state,events:events||[],valid:true};}
function addSpot(input){if(input.extra||input.status==='win'||input.columns.every(c=>!c.length))return input;const s=cloneState(input);s.extra=true;s.active.push(null);s.status='playing';return s;}
