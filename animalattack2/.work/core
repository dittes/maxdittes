function stateKey(s){return s.cells.join('')+'|'+s.active.map(q=>q?`${q.color}${q.type}${q.bites}`:'_').join(',')+'|'+s.columns.map(c=>c.map(q=>q.id).join(',')).join(';');}
function solve(initial,cap=CONFIG.solverCap){const dead=new Set();let visits=0,limited=false;function dfs(s){if(s.status==='win')return[];if(s.status==='lose')return null;if(++visits>cap){limited=true;return null;}const k=stateKey(s);if(dead.has(k))return null;const moves=[];for(let col=0;col<s.columns.length;col++)if(s.columns[col].length){const r=playRound(s,col,false);if(r.valid)moves.push({col,s:r.state,score:r.state.cells.reduce((a,c)=>a+(c!=='.'),0)+r.state.active.filter(Boolean).length*30});}moves.sort((a,b)=>a.score-b.score||a.col-b.col);for(const m of moves){const route=dfs(m.s);if(route)return[m.col,...route];if(limited)break;}if(!limited)dead.add(k);return null;}const route=dfs(initial);return{route,visits,limited};}
function winningFirst(s,cap=7000){const safe=[];let unknown=false;for(let c=0;c<s.columns.length;c++)if(s.columns[c].length){const r=solve(playRound(s,c,false).state,cap);if(r.route)safe.push(c);if(r.limited)unknown=true;}return{safe,unknown};}
function witnessQueue(level,rand,animals){let s=createState(level,[[],[],[],[],[]]),columns=[[],[],[],[],[]],id=0;while(s.cells.some(c=>c!=='.')){const colors=[...new Set(s.cells.filter((c,i)=>c!=='.'&&exposed(s,i)))];const color=id===0&&level.id===0?'R':colors[Math.floor(rand()*colors.length)],col=level.tier===0&&id<5?id:Math.floor(rand()*5),type=animals&&level.tier>0?(level.tier===1?'ladybug':level.tier===2?'beetle':'grasshopper'):'ant';const limit=level.tier===0?18:level.tier===2?65:32;const q={id:id++,color,type,bites:0};const tmp=cloneState(s);for(let n=0;n<limit;n++){const at=target(tmp,q,0);if(at<0)break;for(const cell of BITE[type](tmp,at))tmp.cells[cell]='.';q.bites++;}if(!q.bites)throw Error('Empty generated squad');columns[col].push(q);s=tmp;}return columns;}
function expertLevel(i,animals){
