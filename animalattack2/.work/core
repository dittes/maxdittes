function rng(seed){return()=>{seed|=0;seed=seed+0x6D2B79F5|0;let n=Math.imul(seed^seed>>>15,1|seed);n=n+Math.imul(n^n>>>7,61|n)^n;return((n^n>>>14)>>>0)/4294967296;};}
function levelData(i){const pic=ART[i<5?i%3:i%8],tier=Math.floor(i/6),depth=i<4?1:i<12?2:3;let layers=[];for(let z=0;z<depth;z++){let rows=pic.rows.map(r=>r.padEnd(16,'.'));if(z<depth-1){const colors=tier<2?['R','G','C']:['T','O','P','D','W','B'];rows=rows.map((r,y)=>[...r].map((c,x)=>c==='.'?'.':colors[(Math.floor(x/4)+Math.floor(y/4)+z+i)%colors.length]).join(''));}layers.push(rows);}return{id:i,name:pic.name,tier,w:16,h:16,layers,palette:PALETTE,columns:null,par:0};}
